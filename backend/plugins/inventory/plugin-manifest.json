{
  "code": "inventory",
  "version": "1.0.1",
  "name": "Inventory",
  "description": "Physical SKU inventory (catalog, stock batches) and digital value inventory (voucher pools, float, dispense). Money moves only through core journal entries.",
  "operations": [
    {
      "id": "inventory.sku.list",
      "method": "GET",
      "path": "/v1/plugins/inventory/skus",
      "permission": "inventory.view"
    },
    {
      "id": "inventory.sku.get",
      "method": "GET",
      "path": "/v1/plugins/inventory/skus/{skuId}",
      "permission": "inventory.view"
    },
    {
      "id": "inventory.sku.create",
      "method": "POST",
      "path": "/v1/plugins/inventory/skus",
      "permission": "inventory.sku.manage"
    },
    {
      "id": "inventory.sku.decide",
      "method": "POST",
      "path": "/v1/plugins/inventory/skus/{skuId}/pricing-decision",
      "permission": "inventory.pricing.approve"
    },
    {
      "id": "inventory.stock.batch.list",
      "method": "GET",
      "path": "/v1/plugins/inventory/stock-batches",
      "permission": "inventory.view"
    },
    {
      "id": "inventory.stock.batch.get",
      "method": "GET",
      "path": "/v1/plugins/inventory/stock-batches/{batchId}",
      "permission": "inventory.view"
    },
    {
      "id": "inventory.stock.batch.create",
      "method": "POST",
      "path": "/v1/plugins/inventory/stock-batches",
      "permission": "inventory.stock.upload"
    },
    {
      "id": "inventory.stock.batch.decide",
      "method": "POST",
      "path": "/v1/plugins/inventory/stock-batches/{batchId}/decision",
      "permission": "inventory.stock.approve"
    },
    {
      "id": "inventory.digital.product.list",
      "method": "GET",
      "path": "/v1/plugins/inventory/digital-products",
      "permission": "digital.view"
    },
    {
      "id": "inventory.digital.product.create",
      "method": "POST",
      "path": "/v1/plugins/inventory/digital-products",
      "permission": "digital.product.manage"
    },
    {
      "id": "inventory.voucher.batch.list",
      "method": "GET",
      "path": "/v1/plugins/inventory/voucher-batches",
      "permission": "digital.view"
    },
    {
      "id": "inventory.voucher.batch.get",
      "method": "GET",
      "path": "/v1/plugins/inventory/voucher-batches/{batchId}",
      "permission": "digital.view"
    },
    {
      "id": "inventory.voucher.batch.upload",
      "method": "POST",
      "path": "/v1/plugins/inventory/voucher-batches",
      "permission": "digital.voucher.upload"
    },
    {
      "id": "inventory.voucher.batch.authorize",
      "method": "POST",
      "path": "/v1/plugins/inventory/voucher-batches/{batchId}/authorization",
      "permission": "digital.voucher.authorize"
    },
    {
      "id": "inventory.voucher.dispense",
      "method": "POST",
      "path": "/v1/plugins/inventory/vouchers/dispense",
      "permission": "digital.dispense"
    },
    {
      "id": "inventory.float.deposit.list",
      "method": "GET",
      "path": "/v1/plugins/inventory/float-deposits",
      "permission": "digital.view"
    },
    {
      "id": "inventory.float.deposit.create",
      "method": "POST",
      "path": "/v1/plugins/inventory/float-deposits",
      "permission": "digital.float.deposit"
    },
    {
      "id": "inventory.float.deposit.decide",
      "method": "POST",
      "path": "/v1/plugins/inventory/float-deposits/{depositId}/decision",
      "permission": "digital.float.deposit"
    }
  ],
  "approvals": [
    {
      "action": "SKU_PRICING",
      "makerPermission": "inventory.sku.manage",
      "checkerPermission": "inventory.pricing.approve"
    },
    {
      "action": "STOCK_RECEIPT",
      "makerPermission": "inventory.stock.upload",
      "checkerPermission": "inventory.stock.approve"
    },
    {
      "action": "VOUCHER_RELEASE",
      "makerPermission": "digital.voucher.upload",
      "checkerPermission": "digital.voucher.authorize"
    },
    {
      "action": "FLOAT_FUNDING",
      "makerPermission": "digital.float.deposit",
      "checkerPermission": "digital.float.deposit"
    }
  ],
  "client": {
