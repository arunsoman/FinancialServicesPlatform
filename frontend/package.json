{
  "name": "fsp-spa",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite --host",
    "build": "bunx --bun tsc && bunx --bun vite build",
    "preview": "bunx --bun vite preview",
    "test": "bunx vitest run",
    "test:e2e": "bunx --bun playwright test",
    "storybook": "bunx --bun storybook dev -p 6006",
    "build-storybook": "bunx --bun storybook build",
    "lint": "bunx --bun eslint . --report-unused-disable-directives --max-warnings 0",
    "typecheck": "bunx --bun tsc --noEmit",
    "widgets:check": "bun run tools/widgets.ts check",
    "menus:check": "bun run tools/menus-check.ts",
    "widgets:list": "bun run tools/widgets.ts list",
    "widgets:gen": "bun run tools/widgets.ts gen",
    "widgets:register": "bun run tools/widgets.ts register",
    "workbench": "bunx --bun vite --host --open /widget-workbench/",
    "widgets:skill": "bun run tools/widget-pack/build-skill.ts",
    "widgets:survey": "bun run tools/widget-agent.ts survey",
    "widgets:dto": "bun run tools/widget-agent.ts dto",
    "widgets:plan": "bun run tools/widget-agent.ts plan",
    "widgets:verify": "bun run tools/widget-agent.ts verify",
    "widgets:e2e": "bun run tools/widget-agent.ts e2e",
    "widgets:register-bff": "bun run tools/widget-agent.ts register",
    "widgets:stage": "bun run tools/widget-agent.ts stage",
    "widgets:accept": "bun run tools/widget-agent.ts accept",
    "widgets:done": "bun run tools/widget-agent.ts done",
    "portal:check": "bun run tools/portal-trust.ts check",
    "portal:pin": "bun run tools/portal-trust.ts pin"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.3.0",
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-table": "^8.20.5",
    "@tanstack/react-virtual": "^3.10.8",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^6.27.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@playwright/test": "^1.48.2",
    "@storybook/react": "^8.3.6",
    "@storybook/react-vite": "^8.3.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/ui": "^2.1.3",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.10.2",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^17.14.0",
    "postcss": "^8.4.47",
    "storybook": "^8.3.6",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.3"
  }
}
