# syntax=docker/dockerfile:1
# Runtime-only image: boots a pre-built Spring Boot fat jar on JRE 25 (builds happen on the
# workstation; the bootJars ship as artifacts so the server never runs Gradle).
ARG JAR=jars/core-0.0.1-SNAPSHOT.jar
FROM eclipse-temurin:25-jre-alpine
ARG JAR
WORKDIR /app
COPY ${JAR} /app/app.jar
ENV TZ=UTC
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=60.0", "-jar", "/app/app.jar"]
