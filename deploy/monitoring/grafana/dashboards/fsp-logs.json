{
  "uid": "fsp-logs",
  "title": "FSP logs",
  "description": "Every FSP container's logs (staging kept 4 days, production 30). Correlate with correlation_id / traceId.",
  "tags": [
    "fsp"
  ],
  "timezone": "utc",
  "editable": false,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "custom",
        "query": "staging,production,monitoring",
        "multi": true,
        "includeAll": false,
        "options": [
          {
            "text": "staging",
            "value": "staging",
            "selected": false
          },
          {
            "text": "production",
            "value": "production",
            "selected": false
          },
          {
            "text": "monitoring",
            "value": "monitoring",
            "selected": false
          }
        ],
        "current": {
          "text": "staging",
          "value": "staging"
        }
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "query": {
          "type": 1,
          "label": "service",
          "stream": "{env=~\"$env\"}",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "query": "ERROR,WARN,INFO,DEBUG",
        "multi": true,
        "includeAll": true,
        "options": [
          {
            "text": "ERROR",
            "value": "ERROR",
            "selected": false
          },
          {
            "text": "WARN",
            "value": "WARN",
            "selected": false
          },
          {
            "text": "INFO",
            "value": "INFO",
            "selected": false
          },
          {
            "text": "DEBUG",
            "value": "DEBUG",
            "selected": false
          }
        ],
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "search",
        "label": "Search (regex)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Log lines per service",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (service) (count_over_time({env=~\"$env\", service=~\"$service\", level=~\"$level\"} |~ \"(?i)$search\" [$__auto]))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Errors per service",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (service) (count_over_time({env=~\"$env\", service=~\"$service\"} |~ \"level=ERROR|(?i)\\\\b(error|exception|fatal|panic)\\\\b\" [$__auto]))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Logs \u2014 $env",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{env=~\"$env\", service=~\"$service\", level=~\"$level\"} |~ \"(?i)$search\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "showLabels": false
      }
    }
  ],
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "FSP",
      "type": "dashboards",
      "tags": [
        "fsp"
      ],
      "asDropdown": false
    }
  ]
}